# Token que te da @BotFather. Lo rellena el programa la primera vez (página /configurar).
# En Windows se guarda cifrado ("dpapi:…"): solo sirve con tu usuario de Windows en este ordenador.
TELEGRAM_TOKEN=
# Dirección con la que se abre la web. Para el móvil usa la IP local del ordenador, p. ej. http://192.168.1.20:3000
URL_BASE=http://localhost:3000
# Puerto y host del servidor (0.0.0.0 = accesible desde la red local)
PUERTO=3000
HOST=0.0.0.0
# Proveedor de búsqueda: "duckduckgo" (sin clave). Para otro, ver README.md
PROVEEDOR_BUSQUEDA=duckduckgo
CLAVE_BUSQUEDA=
# El ejecutable abre el chat del bot al arrancar. Pon "no" para que no lo haga.
ABRIR_TELEGRAM=si
